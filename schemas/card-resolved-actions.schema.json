{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved Card Skill handoff aligned with ResolvedIntent v1.1.0",
  "oneOf": [
    { "$ref": "#/$defs/get" },
    { "$ref": "#/$defs/setBudget" },
    { "$ref": "#/$defs/freeze" },
    { "$ref": "#/$defs/unfreeze" }
  ],
  "$defs": {
    "intentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
    "cardId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "currency": { "const": "CNY" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "entity_type", "entity_id", "source"],
      "properties": {
        "slot": { "const": "card_ref" },
        "entity_type": { "const": "card" },
        "entity_id": { "$ref": "#/$defs/cardId" },
        "source": { "enum": ["financial_context", "user_selection", "tool_result"] }
      }
    },
    "references": {
      "$comment": "JSON Schema cannot compare sibling values; validateResolvedCardIntent enforces references[0].entity_id === resolved_slots.card_id.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    },
    "missingSlots": { "type": "array", "maxItems": 0 },
    "readSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id"],
      "properties": { "card_id": { "$ref": "#/$defs/cardId" } }
    },
    "get": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "action", "state", "resolved_slots", "references", "missing_slots"],
      "properties": {
        "intent_id": { "$ref": "#/$defs/intentId" },
        "action": { "const": "card.get" },
        "state": { "const": "ready_for_planning" },
        "resolved_slots": { "$ref": "#/$defs/readSlots" },
        "references": { "$ref": "#/$defs/references" },
        "missing_slots": { "$ref": "#/$defs/missingSlots" }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "action", "state", "resolved_slots", "references", "missing_slots"],
      "properties": {
        "intent_id": { "$ref": "#/$defs/intentId" },
        "action": { "const": "card.freeze" },
        "state": { "const": "ready_for_planning" },
        "resolved_slots": { "$ref": "#/$defs/readSlots" },
        "references": { "$ref": "#/$defs/references" },
        "missing_slots": { "$ref": "#/$defs/missingSlots" }
      }
    },
    "unfreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "action", "state", "resolved_slots", "references", "missing_slots"],
      "properties": {
        "intent_id": { "$ref": "#/$defs/intentId" },
        "action": { "const": "card.unfreeze" },
        "state": { "const": "ready_for_planning" },
        "resolved_slots": { "$ref": "#/$defs/readSlots" },
        "references": { "$ref": "#/$defs/references" },
        "missing_slots": { "$ref": "#/$defs/missingSlots" }
      }
    },
    "setBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "action", "state", "resolved_slots", "references", "missing_slots"],
      "properties": {
        "intent_id": { "$ref": "#/$defs/intentId" },
        "action": { "const": "card.set_budget" },
        "state": { "const": "ready_for_planning" },
        "references": { "$ref": "#/$defs/references" },
        "missing_slots": { "$ref": "#/$defs/missingSlots" },
        "resolved_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["card_id", "amount"],
          "properties": {
            "card_id": { "$ref": "#/$defs/cardId" },
            "amount": { "$ref": "#/$defs/amount" }
          }
        }
      }
    }
  }
}
