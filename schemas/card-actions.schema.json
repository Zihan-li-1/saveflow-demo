{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Card action fragment carried by ParsedIntentEnvelope v1.1.0",
  "oneOf": [
    { "$ref": "#/$defs/get" },
    { "$ref": "#/$defs/setBudget" },
    { "$ref": "#/$defs/setControls" },
    { "$ref": "#/$defs/securityReview" },
    { "$ref": "#/$defs/freeze" },
    { "$ref": "#/$defs/unfreeze" }
  ],
  "$defs": {
    "cardRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        { "pattern": "\\S" },
        { "not": { "pattern": "^\\s*[Cc][Aa][Rr][Dd][_-][a-zA-Z0-9_-]+\\s*$" } }
      ]
    },
    "referenceSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_ref"],
      "properties": { "card_ref": { "$ref": "#/$defs/cardRef" } }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "currency": { "const": "CNY" }
      }
    },
    "alertAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "currency": { "const": "CNY" }
      }
    },
    "get": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "slots"],
      "properties": { "action": { "const": "card.get" }, "slots": { "$ref": "#/$defs/referenceSlots" } }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "slots"],
      "properties": { "action": { "const": "card.freeze" }, "slots": { "$ref": "#/$defs/referenceSlots" } }
    },
    "unfreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "slots"],
      "properties": { "action": { "const": "card.unfreeze" }, "slots": { "$ref": "#/$defs/referenceSlots" } }
    },
    "setBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "slots"],
      "properties": {
        "action": { "const": "card.set_budget" },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["card_ref", "amount"],
          "properties": {
            "card_ref": { "$ref": "#/$defs/cardRef" },
            "amount": { "$ref": "#/$defs/amount" }
          }
        }
      }
    },
    "setControls": {
      "type": "object", "additionalProperties": false, "required": ["action", "slots"],
      "properties": { "action": { "const": "card.set_controls" }, "slots": {
        "type": "object", "additionalProperties": false, "required": ["card_ref"], "minProperties": 2,
        "properties": { "card_ref": { "$ref": "#/$defs/cardRef" }, "online_payments_enabled": { "type": "boolean" }, "blocked_categories": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } }, "alert_amount": { "anyOf": [{ "$ref": "#/$defs/alertAmount" }, { "type": "null" }] }, "balance_reminder_amount": { "anyOf": [{ "$ref": "#/$defs/amount" }, { "type": "null" }] }, "balance_reminder_percentage": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "type": "null" }] } }
      } }
    },
    "securityReview": {
      "type": "object", "additionalProperties": false, "required": ["action", "slots"],
      "properties": { "action": { "const": "card.security_review" }, "slots": { "type": "object", "additionalProperties": false, "required": ["card_ref", "issue_type"], "properties": { "card_ref": { "$ref": "#/$defs/cardRef" }, "issue_type": { "enum": ["card_details_exposed", "unauthorized_transaction", "device_lost"] } } } }
    }
  }
}
