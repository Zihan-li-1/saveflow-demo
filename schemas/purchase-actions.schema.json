{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "scenario.plan_purchase"
        },
        "input": {
          "type": "object",
          "properties": {
            "budget": {
              "type": "object",
              "properties": {
                "amount_minor": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "currency": {
                  "type": "string",
                  "const": "CNY"
                }
              },
              "required": [
                "amount_minor",
                "currency"
              ],
              "additionalProperties": false
            },
            "budget_month": {
              "type": "string",
              "minLength": 1,
              "maxLength": 7,
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "funding_account_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "date_expression": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "date_meaning": {
              "type": "string",
              "enum": [
                "order_on",
                "deliver_on"
              ]
            },
            "items": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "flowers",
                      "cake"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "category",
                  "quantity"
                ],
                "additionalProperties": false
              }
            },
            "selection_mode": {
              "type": "string",
              "enum": [
                "guided",
                "browse"
              ]
            },
            "preferences": {
              "type": "object",
              "properties": {
                "flower_colors": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "flower_materials": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "flower_exclusions": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "scent_preference": {
                  "type": "string",
                  "enum": [
                    "none",
                    "light",
                    "any"
                  ]
                },
                "cake_flavors": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "cake_servings": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "ingredient_exclusions": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "occasion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "style": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "input"
