# mock: offline synthetic demo; http: your own sandbox BFF, not a bank endpoint
NEXT_PUBLIC_SAVEFLOW_API_MODE=mock
# HTTP mode requires a separately hosted API when publishing the static out folder.
# Example only. Replace with your own authorized sandbox service.
NEXT_PUBLIC_SAVEFLOW_API_BASE_URL=
NEXT_PUBLIC_SAVEFLOW_API_TIMEOUT_MS=10000
# NEXT_PUBLIC values are embedded at build time. Never put secrets here.

# Server-only Qwen configuration. Copy this file to .env.local for local development.
# Keep the business API mode above as mock: model inference is real, banking operations are simulated.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set a private demo access code (16+ characters), then enter it in the page.
# It is NOT your DashScope API key. Never expose the API key to the browser.
SAVEFLOW_ACCESS_CODE=
CONTINUATION_TOKEN_SECRET=
# Entire Banking understanding flow: trueforge (default) or legacy-qwen.
# Runtime errors never cause automatic fallback; /api/agent is independent.
SAVEFLOW_BANKING_RUNTIME=trueforge

# Retired standalone MCP pilot/bridge switches; no longer select Banking API routes.
SAVEFLOW_TRUEFORGE_BILL_ENABLED=false
SAVEFLOW_TRUEFORGE_READ_ENABLED=false
SAVEFLOW_TRUEFORGE_TRANSFER_ENABLED=false
SAVEFLOW_TRUEFORGE_CARD_PREVIEW_ENABLED=false
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=test/deepseek-v4-1-flash
TRUEFORGE_MCP_SERVER=sv-trial
# Standalone pilot only: optional credential bridge for multi-turn tools (port 3334).
TRUEFORGE_SKILL_MCP_SERVER=
# Omit in local standalone mode; use an OIDC bearer token on an authenticated server.
TRUEFORGE_TOKEN=

# Optional for local Mock; required on Netlify unless ALLOW_EPHEMERAL_BANKING=true.
# Apply the schema first with npm run db:migrate. Never expose this server-only URL.
DATABASE_URL=

# 高风险转账 OTP 演示固定码（合成演示专用，不是真实短信/银行级 MFA）。
# 本地临时演示（无 DATABASE_URL 且非 Netlify）默认使用 DEMO_OTP_CODE=123456，演示时口头告知、界面不展示。
# 任何持久化 / Netlify / 类生产配置，必须显式 SAVEFLOW_DEMO_OTP_ENABLED=true 才启用固定码，
# 否则不注入固定码（OTP 用随机码且无投递渠道 → 校验不可能成功 → 执行能力保持关闭，安全失败）。
SAVEFLOW_DEMO_OTP_ENABLED=false
# SAVEFLOW_DEMO_OTP_CODE=123456
# Explicit synthetic trial MCP opt-in; keep separate from the website Core DB.
# Requires migrations and a stable CONTINUATION_TOKEN_SECRET. Never use a real-bank database.
SAVEFLOW_TRIAL_DATABASE_URL=

# Banking Core uses /api/banking; legacy plan compatibility uses /api/saveflow.
# npm run dev:qwen starts both; Banking uses the selected runtime, /api/agent uses Qwen.
# For same-origin HTTP Mock: mode=http, base URL empty, enter the access code in the UI.
# Mock state is in memory only. This is not a durable bank service.
