# mock: offline synthetic demo; http: your own sandbox BFF, not a bank endpoint
NEXT_PUBLIC_SAVEFLOW_API_MODE=mock
# HTTP mode requires a separately hosted API when publishing the static out folder.
# Example only. Replace with your own authorized sandbox service.
NEXT_PUBLIC_SAVEFLOW_API_BASE_URL=
NEXT_PUBLIC_SAVEFLOW_API_TIMEOUT_MS=10000
# NEXT_PUBLIC values are embedded at build time. Never put secrets here.

# Server-only Qwen configuration. Copy this file to .env.local for local development.
# Keep the business API mode above as mock: model inference is real, banking operations are simulated.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set a private demo access code (16+ characters), then enter it in the page.
# It is NOT your DashScope API key. Never expose the API key to the browser.
SAVEFLOW_ACCESS_CODE=
CONTINUATION_TOKEN_SECRET=

# Banking Core uses /api/banking; legacy plan compatibility uses /api/saveflow.
# npm run dev:qwen starts both without calling Qwen until /api/agent is requested.
# For same-origin HTTP Mock: mode=http, base URL empty, enter the access code in the UI.
# Mock state is in memory only. This is not a durable bank service.
